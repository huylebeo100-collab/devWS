<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="four_wheel_sensor_bot">

  <!-- =====================================================
       KICH THUOC DO TU ROBOT THAT  (cap nhat 2026-09-06)

         than xe (khoi)      : dai 500 x rong 400 mm
         chieu cao khoi      : 165 mm  (TAM THOI): bang dung cao do
                                          mat de LiDAR, khung chua hoan thien
         banh dan dong       : D = 95 mm
         khoang cach 2 banh  : 390 mm  (do duoc 390-391)
         banh do (caster)    : d = 50 mm, o x,y = +-170 mm
         gam xe              : dat -> mat duoi de = 20 mm, de day 2 mm

       GOC TOA DO (base_link) theo dung dinh nghia cua ban:
         - x, y : chinh giua khoi
         - z    : MAT TREN cua de  = 22 mm tren mat dat
       => mat dat nam o z = -0.022  (chinh la base_footprint)
     ===================================================== -->

  <!-- gam xe: dat -> mat duoi de -->
  <xacro:property name="ground_clearance" value="0.020"/>
  <!-- be day tam de -->
  <xacro:property name="plate_thickness"  value="0.002"/>
  <!-- cao do cua base_link so voi mat dat. MOI link khac deu tinh tu day. -->
  <xacro:property name="base_z" value="${ground_clearance + plate_thickness}"/>

  <xacro:property name="body_length" value="0.50"/>
  <xacro:property name="body_width"  value="0.40"/>
  <!-- TAM THOI cho noc khung = mat de LiDAR (16.5 cm tren base_link).
       Khi hoan thien khung thi sua dung 1 so nay. -->
  <xacro:property name="body_height" value="0.185"/>
  <!-- TODO: can robot that roi sua. 12 kg chi la uoc luong. -->
  <xacro:property name="body_mass"   value="12.0"/>

  <!-- Banh dan dong: D = 95 mm -->
  <xacro:property name="wheel_radius" value="0.0475"/>
  <!-- Suy ra tu "banh loi ra ngoai than 0.2 mm moi ben":
       0.195 + w/2 = 0.200 + 0.0002  ->  w = 0.0104
       TODO: do lai be day banh that. -->
  <xacro:property name="wheel_width"  value="0.0104"/>
  <xacro:property name="wheel_mass"   value="0.5"/>

  <xacro:property name="wheel_separation" value="0.389"/>
  <xacro:property name="wheel_y" value="${wheel_separation / 2.0}"/>
  <!-- truc banh phai o dung do cao ban kinh banh so voi MAT DAT,
       ma base_link lai cao hon dat base_z  ->  tru di.
       = 0.0475 - 0.022 = 0.0255  (khop so ban tu tinh) -->
  <xacro:property name="wheel_z" value="${wheel_radius - base_z}"/>

  <!-- Banh do: d = 50 mm -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.3"/>
  <xacro:property name="caster_x"      value="0.17"/>
  <xacro:property name="caster_y"      value="0.17"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 ${z/2}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_z_inertial" params="mass radius length">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + length*length) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass * (3.0*radius*radius + length*length) / 12.0}" iyz="0.0"
        izz="${mass * radius*radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2.0/5.0) * mass * radius * radius}" ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0) * mass * radius * radius}" iyz="0.0"
        izz="${(2.0/5.0) * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
  <material name="black"><color rgba="0.02 0.02 0.02 1.0"/></material>
  <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="green"><color rgba="0.0 1.0 0.0 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertial
      mass="${body_mass}"
      x="${body_length}"
      y="${body_width}"
      z="${body_height}"/>
  </link>
  <!-- footprint = hinh chieu xuong MAT DAT.
       base_link cao hon mat dat base_z (= gam 20mm + de 2mm) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_footprint">
  </link>
  <!-- -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <xacro:cylinder_z_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${wheel_y} ${wheel_z}" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <gazebo reference="left_wheel_link">
    <mu1 value="3.0"/>
    <mu2 value="3.0"/>
  </gazebo>


  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <xacro:cylinder_z_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_y} ${wheel_z}" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <gazebo reference="right_wheel_link">
    <mu1 value="3.0"/>
    <mu2 value="3.0"/>
  </gazebo>

  <xacro:macro name="caster_wheel" params="name x y">
    <link name="${name}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertial mass="${caster_mass}" radius="${caster_radius}"/>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} ${y} ${caster_radius - base_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}_caster_link">
      <mu1 value="0.0"/>
      <mu2 value="0.0"/>
    </gazebo>
  </xacro:macro>

  <xacro:caster_wheel name="front_left"  x="${caster_x}"  y="${caster_y}"/>
  <xacro:caster_wheel name="front_right" x="${caster_x}"  y="${-caster_y}"/>
  <xacro:caster_wheel name="rear_left"   x="${-caster_x}" y="${caster_y}"/>
  <xacro:caster_wheel name="rear_right"  x="${-caster_x}" y="${-caster_y}"/>

  <xacro:include filename="sensor.xacro"/>
  <xacro:include filename="gazebo_control.xacro"/>
  
  <xacro:sensors parent="base_link"/>

</robot>