<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- RPLIDAR A2M8 : D 76 mm, cao 41 mm, ~190 g
       TODO: doi chieu lai voi con hang that cua ban. -->
  <xacro:property name="lidar_radius" value="0.038"/>
  <xacro:property name="lidar_length" value="0.041"/>
  <xacro:property name="lidar_mass"   value="0.19"/>
  <!-- Khoang cach tu CHAN DE lidar len MAT PHANG QUET.
       lidar_link phai nam o tam quang hoc, khong phai o chan de.
       TODO: do bang thuoc tu day de len giua dai cua so trong suot.
       0.030 chi la uoc luong khoi diem. -->
  <xacro:property name="lidar_optical_offset" value="0.030"/>

  <xacro:property name="imu_length" value="0.05"/>
  <xacro:property name="imu_width"  value="0.05"/>
  <xacro:property name="imu_height" value="0.02"/>
  <xacro:property name="imu_mass"   value="0.02"/>

  <!-- Vi tri do tu TAM ROBOT (base_link):
         x = -(95 mm + ban kinh lidar) = -(0.095 + 0.038) = -0.133
             => LiDAR nam PHIA SAU tam 133 mm.
             (URDF cu de +0.20, tuc LECH 333 mm so voi thuc te)
         z = 165 mm den CHAN de lidar, cong them offset quang hoc. -->
  <xacro:property name="lidar_x" value="${body_length/2 - 0.005 - lidar_radius}"/>
  <xacro:property name="lidar_y" value="0.00"/>
  <xacro:property name="lidar_z" value="${body_height + lidar_optical_offset}"/>

  <!-- IMU gan trong than xe, gan tam quay cang tot -->
  <xacro:property name="imu_x" value="0.00"/>
  <xacro:property name="imu_y" value="0.00"/>
  <xacro:property name="imu_z" value="${body_height/2}"/>

  <xacro:macro name="sensors" params="parent">

    <link name="lidar_link">
      <!-- lidar_link o TAM QUANG HOC; than vat ly nam thap hon,
           nen visual/collision phai bu lai offset. -->
      <visual>
        <origin xyz="0 0 ${lidar_length/2 - lidar_optical_offset}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${lidar_length}" radius="${lidar_radius}"/>
        </geometry>
        <material name="gray"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${lidar_length/2 - lidar_optical_offset}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${lidar_length}" radius="${lidar_radius}"/>
        </geometry>
      </collision>

      <xacro:cylinder_z_inertial
        mass="${lidar_mass}"
        radius="${lidar_radius}"
        length="${lidar_length}"/>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${pi}"/>
    </joint>

    <gazebo reference="lidar_link">
      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <!-- A2M8 ~400-800 diem/vong tuy scan_mode. Kiem tra bang:
                   ros2 topic echo /scan (once) roi dem so phan tu ranges -->
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <!-- A2M8: vung mu 0.15 m. De 0.05 la sim "sach" hon that. -->
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.015</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <link name="imu_link">
      <visual>
        <geometry>
          <box size="${imu_length} ${imu_width} ${imu_height}"/>
        </geometry>
        <material name="green"/>
      </visual>

      <collision>
        <geometry>
          <box size="${imu_length} ${imu_width} ${imu_height}"/>
        </geometry>
      </collision>

      <xacro:box_inertial
        mass="${imu_mass}"
        x="${imu_length}"
        y="${imu_width}"
        z="${imu_height}"/>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu</topic>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>