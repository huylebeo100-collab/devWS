            <diffuse>0.78 0.78 0.78 1</diffuse>
            <specular>0.30 0.30 0.30 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Warehouse map for AMR footprint 0.50 m x 0.40 m.
